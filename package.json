{
  "name": "m2rf",
  "version": "0.1.0",
  "description": "Mermaid to ReactFlow - Render Mermaid diagrams as interactive ReactFlow graphs with embedded React components",
  "type": "module",
  "workspaces": ["site"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mermaid",
    "reactflow",
    "diagrams",
    "flowchart",
    "react",
    "mdx"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "zustand": "^4.0.0 || ^5.0.0"
  },
  "dependencies": {
    "dagre": "^0.8.5",
    "mermaid": "^11.12.1",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/dagre": "^0.7.53",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rolldown": "^1.0.0-beta.50",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-dts": "^4.5.4",
    "zustand": "^5.0.8"
  }
}
