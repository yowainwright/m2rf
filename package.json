{
  "name": "m2rf",
  "version": "0.0.0",
  "description": "Render Mermaid diagrams as ReactFlow graphs",
  "author": "Jeff Wainwright <me@jeffry.in> (https://jeffry.in)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yowainwright/m2rf"
  },
  "type": "module",
  "packageManager": "pnpm@12.2.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26 <27",
      "onFail": "error"
    }
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm --dir site dev",
    "dev:site": "pnpm --dir site dev",
    "build": "pnpm --dir site build",
    "build:js": "vite build",
    "build:types": "tsc --emitDeclarationOnly --outDir dist --noEmit false",
    "build:watch": "vite build --watch",
    "deps:check": "codependence --files package.json site/package.json",
    "deps:overrides": "pastoralist",
    "deps:security": "pastoralist --checkSecurity --hasWorkspaceSecurityChecks",
    "lint": "pnpm run lint:all",
    "lint:all": "pnpm run lint:oxlint && pnpm run lint:shell",
    "lint:ci": "pnpm run lint:oxlint && pnpm run lint:shell:ci",
    "lint:oxlint": "oxlint -c .oxlintrc.json site/src site/tests",
    "lint:oxlint:strict": "oxlint -c .oxlintrc.json --deny-warnings site/src site/tests",
    "lint/run": "pnpm run lint:all",
    "lint/session": "pnpm run lint:all",
    "lint/session/all": "pnpm run lint:all",
    "lint/setup": "sh scripts/setup.sh --hooks-only",
    "lint:shell": "shfmt -d scripts/setup.sh && pnpm run lint:shell:ci && shellcheck-legibility check scripts/setup.sh",
    "lint:shell:ci": "shellcheck -x -S warning scripts/setup.sh",
    "typecheck": "pnpm --dir site typecheck",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:e2e": "pnpm --dir site test:e2e",
    "test:integration": "pnpm --dir site test:integration",
    "test:unit": "pnpm --dir site test:unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "update:deps": "codependence --files package.json site/package.json --update",
    "validate": "pnpm run lint/session && pnpm run typecheck && pnpm run test && pnpm run build",
    "setup": "sh scripts/setup.sh",
    "prepublishOnly": "pnpm run validate"
  },
  "keywords": [
    "mermaid",
    "reactflow",
    "diagrams",
    "flowchart",
    "react",
    "mdx"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "xstate": "^5.32.6"
  },
  "dependencies": {
    "canvg": "^4.0.3",
    "dagre": "^0.8.5",
    "effect": "^3.22.1",
    "gifenc": "^1.0.3",
    "mermaid": "^11.17.2",
    "reactflow": "^11.11.4",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.5.4",
    "codependence": "^1.0.12",
    "eslint": "10.9.1",
    "eslint-plugin-legibility": "0.3.5",
    "happy-dom": "^20.11.6",
    "jsdom": "^30.0.1",
    "oxlint": "1.80.0",
    "pastoralist": "^1.13.1",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rolldown": "^1.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.0.16",
    "xstate": "^5.32.6"
  },
  "workspaces": [
    "site"
  ]
}
