{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    {
      "name": "legibility",
      "specifier": "oxlint-plugin-legibility"
    }
  ],
  "rules": {
    "no-restricted-properties": [
      "error",
      {
        "object": "Promise",
        "property": "all",
        "message": "Promise.all is not allowed. Use composable async work or Promise.allSettled."
      }
    ],
    "legibility/hoist-if-operators": [
      "warn",
      {
        "max": 0
      }
    ],
    "legibility/max-expression-operators": [
      "warn",
      {
        "max": 4
      }
    ],
    "legibility/no-complex-ternaries": [
      "warn",
      {
        "max": 2
      }
    ],
    "legibility/no-computed-values": [
      "warn",
      {
        "max": 1
      }
    ],
    "legibility/no-hidden-side-effects": [
      "warn",
      {
        "mutatingMethods": [
          "add",
          "clear",
          "copyWithin",
          "fill",
          "pop",
          "push",
          "reverse",
          "set",
          "shift",
          "sort",
          "splice",
          "unshift"
        ]
      }
    ],
    "legibility/no-quadratic-patterns": "warn",
    "legibility/no-standalone-array-mutations": "warn",
    "legibility/prefer-concat-object-assign": "warn"
  },
  "overrides": [
    {
      "files": ["../app/**/*.ts", "../app/**/*.tsx", "../tests/**/*.ts"],
      "rules": {
        "require-await": "warn"
      }
    }
  ]
}
