{
  "name": "m2rf",
  "version": "0.0.0",
  "private": true,
  "description": "The m2rf Mermaid diagram editor",
  "author": "Jeff Wainwright <me@jeffry.in> (https://jeffry.in)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yowainwright/m2rf"
  },
  "type": "module",
  "packageManager": "pnpm@12.2.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26 <27",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "next dev --port ${M2RF_APP_PORT:-54783}",
    "build": "next build --webpack",
    "deps:check": "codependence",
    "deps:overrides": "pastoralist",
    "deps:security": "pastoralist --dry-run --checkSecurity --hasWorkspaceSecurityChecks --strict",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm run lint:all",
    "lint:all": "pnpm run lint:fs && pnpm run lint:src && pnpm run lint:oxlint && pnpm run lint:shell",
    "lint:ci": "pnpm run lint:fs && pnpm run lint:src && pnpm run format:check && pnpm run lint:oxlint:strict && pnpm run lint:shell:ci",
    "lint:fs": "fs-lint check --base \"${FS_LINT_BASE:-HEAD}\" && (git diff --no-renames --diff-filter=A --name-only -z HEAD && git ls-files --others --exclude-standard -z) | fs-lint check --stdin0",
    "lint:src": "git ls-files --cached --others --exclude-standard --deduplicate -z -- app tests scripts ':!:app/components/ui/**' | xargs -0 -n 1 sh -c 'test ! -f \"$1\" || src-lint check \"$1\"' sh",
    "lint:oxlint": "oxlint -c .oxlintrc.json app tests scripts/mcp tests/unit/scripts/mcp",
    "lint:oxlint:strict": "oxlint -c .oxlintrc.json --deny-warnings app tests scripts/mcp tests/unit/scripts/mcp",
    "lint/run": "pnpm run lint:all",
    "lint/session": "pnpm run lint:fs && pnpm run lint:src && pnpm run format:check && pnpm run lint:oxlint:strict && pnpm run lint:shell",
    "lint/session/all": "pnpm run lint/session",
    "lint/setup": "sh scripts/setup.sh --hooks-only",
    "lint:shell": "shfmt -d scripts/setup.sh && pnpm run lint:shell:ci && shellcheck-legibility check scripts/setup.sh",
    "lint:shell:ci": "shellcheck -x -S warning scripts/setup.sh",
    "mcp:generate": "node scripts/mcp/index.ts",
    "mcp:check": "node \"$HOME/.agents/lib/mcp/client.js\" --config .agents/mcp/shadcn.json shadcn get_item_examples_from_registries '{\"registries\":[\"@shadcn\"],\"query\":\"resizable-demo\"}'",
    "typecheck": "pnpm run typecheck:mcp && tsc --noEmit",
    "typecheck:mcp": "tsc --ignoreConfig --noEmit --module nodenext --target esnext --types node --allowImportingTsExtensions --skipLibCheck scripts/mcp/*.ts tests/unit/scripts/mcp/*.test.ts",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:e2e": "TMPDIR=.next/cache PLAYWRIGHT_LAST_RUN_OUTPUT_FILE=.next/cache/playwright/.last-run.json playwright test --config playwright.config.ts",
    "test:integration": "TMPDIR=.next/cache vitest run --config vitest.config.mts tests/integration",
    "test:mcp": "node --test tests/unit/scripts/mcp/*.test.ts",
    "test:unit": "pnpm run test:mcp && TMPDIR=.next/cache vitest run --config vitest.config.mts tests/unit",
    "update": "pnpm run update:deps && pnpm install",
    "update:deps": "codependence --update",
    "validate": "pnpm run lint/session && pnpm run typecheck && pnpm run test && pnpm run build",
    "setup": "sh scripts/setup.sh",
    "prepare": "sh scripts/setup.sh prepare",
    "postinstall": "pastoralist"
  },
  "codependence": {
    "config": {
      "app": {
        "path": "package.json",
        "manager": "pnpm",
        "mode": "precise",
        "lockfile": true
      }
    }
  },
  "dependencies": {
    "@codemirror/view": "^6.43.11",
    "@pinojs/redact": "^0.4.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@uiw/react-codemirror": "^4.25.11",
    "@xstate/react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror-lang-mermaid": "^0.5.0",
    "dexie": "4.4.6",
    "effect": "^3.22.2",
    "gifenc": "^1.0.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.46.0",
    "mermaid": "^12.0.0",
    "motion": "^13.3.0",
    "next": "^16.3.5",
    "pino": "^10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.12.4",
    "reactflow": "^11.11.4",
    "shaders": "^3.2.470",
    "tailwind-merge": "^3.7.0",
    "xstate": "^5.33.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.0",
    "codependence": "^1.0.15",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.0.1",
    "oxfmt": "0.67.0",
    "oxlint": "1.83.0",
    "oxlint-plugin-legibility": "^0.0.4",
    "pastoralist": "^1.13.2",
    "postcss": "^8.5.28",
    "rolldown": "^1.2.8",
    "shadcn": "4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
